{% block content %}
<!-- ═══ HERO ═══ -->
<div class="hero">
  <div class="hero-kicker">Industry Intelligence Briefing</div>
  <h1>AI Tools in Construction:<br>Who's Winning, Who's Funded, and What It Means for Your Firm</h1>
  <p class="hero-deck">A competitive intelligence briefing covering 20+ companies, $126M+ in recent funding, and the adoption data every construction executive needs to understand right now.</p>
</div>

<!-- ═══ STAT BAR ═══ -->
<div class="stat-bar">
  <div class="stat-bar-inner">
    <div class="stat-item">
      <div class="stat-number">38%</div>
      <div class="stat-label">of contractors now report measurable AI impact — up from 17% one year ago</div>
    </div>
    <div class="stat-item">
      <div class="stat-number">$6.02B</div>
      <div class="stat-label">global AI-in-construction market size, 2026</div>
    </div>
    <div class="stat-item">
      <div class="stat-number">499K</div>
      <div class="stat-label">new workers the industry needs in 2026 to meet demand</div>
    </div>
    <div class="stat-item">
      <div class="stat-number">68%</div>
      <div class="stat-label">of contech VC in Q2 2025 went to AI/ML startups</div>
    </div>
  </div>
</div>

<!-- ═══ SECTION NAV ═══ -->
