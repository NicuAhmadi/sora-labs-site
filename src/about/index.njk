      <div class="footer-left">© 2026 Sora Labs. All rights reserved.</div>
      <div class="footer-links">
        <a href="/services/">Services</a>
        <a href="/local-businesses/">Local Businesses</a>
        <a href="/resources/">Resources</a>
        <a href="/contact/">Contact</a>
        <a href="/products/">For AI Operators</a>
        <a href="https://buttondown.com/nclawdev" target="_blank" rel="noopener">Newsletter</a>
      </div>
    </div>
  </div>
</footer>
{% endblock %}
