---
permalink: /index.html
---

{% extends "layouts/base.njk" %}

{% block head %}
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AI Consulting & Market Intelligence — Sora Labs</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Libre+Franklin:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #0A0A0C;
  --bg-elevated: #111114;
  --bg-card: #161619;
  --glass-border: rgba(255,255,255,0.06);
  --glass-border-hover: rgba(255,255,255,0.1);
  --border: #252529;
  --border-subtle: #1A1A1E;
  --text: #EFEEEA;
  --text-secondary: #B4B3BA;
  --text-dim: #837F87;
  --accent: #C9A84C;
  --accent-soft: #C9A84C20;
  --accent-glow: #C9A84C15;
  --accent-hover: #DABB5E;
  --green: #4EAD6B;
  --green-soft: #4EAD6B18;
  --blue: #5B8DEF;
  --blue-soft: #5B8DEF15;
  --coral: #D97756;
  --coral-soft: #D9775615;
  --display: 'Playfair Display', Georgia, serif;
  --body: 'Libre Franklin', system-ui, sans-serif;
  --mono: 'JetBrains Mono', monospace;
  --radius: 16px;
  --radius-sm: 10px;
  --gap: 16px;
}

*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; }

body {
  background: var(--bg);
  color: var(--text);
  font-family: var(--body);
  font-size: 16px;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}

body::after {
  content: '';
  position: fixed; inset: 0; z-index: 9999; pointer-events: none;
  opacity: 0.03;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
}

a { color: inherit; text-decoration: none; }
.container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(24px); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

.anim { animation: fadeUp 0.65s ease-out both; animation-play-state: paused; }
.d1 { animation-delay: 0.05s; } .d2 { animation-delay: 0.1s; }
.d3 { animation-delay: 0.15s; } .d4 { animation-delay: 0.2s; }
.d5 { animation-delay: 0.25s; } .d6 { animation-delay: 0.3s; }
.d7 { animation-delay: 0.35s; } .d8 { animation-delay: 0.4s; }

/* ═══ NAV ═══ */
nav {
  position: fixed; top: 0; left: 0; right: 0; z-index: 100;
  padding: 16px 0;
  background: rgba(10,10,12,0.85);
  backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
  border-bottom: 1px solid var(--border-subtle);
}
nav .container { display: flex; align-items: center; justify-content: space-between; }
.nav-logo {
  display: flex; align-items: center; gap: 10px;
  font-family: var(--display); font-size: 1.3rem; font-weight: 500;
}
.nav-mark {
  width: 30px; height: 30px; background: var(--accent); border-radius: 7px;
  display: flex; align-items: center; justify-content: center;
  font-family: var(--mono); font-weight: 600; font-size: 0.8rem; color: var(--bg);
}
.nav-links { display: flex; gap: 28px; align-items: center; }
.nav-links a {
  font-size: 0.82rem; font-weight: 500; color: var(--text-dim);
  transition: color 0.2s; letter-spacing: 0.02em;
}
.nav-links a:hover { color: var(--text-secondary); }
.nav-links a.active { color: var(--accent); }
.nav-cta {
  color: var(--bg) !important; background: var(--accent);
  padding: 7px 16px; border-radius: 6px; font-weight: 600 !important;
  transition: background 0.2s;
}
.nav-cta:hover { background: var(--accent-hover); }

/* ═══ HERO ═══ */
.hero {
  padding: 160px 0 80px; position: relative; text-align: center;
}
.hero::before {
  content: ''; position: absolute; top: -100px; left: 50%; transform: translateX(-50%);
  width: 900px; height: 600px;
  background: radial-gradient(ellipse, var(--accent-glow) 0%, transparent 65%);
  pointer-events: none;
}
.hero-label {
  display: inline-block;
  font-family: var(--mono); font-size: 0.7rem; font-weight: 500;
  color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.14em;
  margin-bottom: 24px;
}
.hero h1 {
  font-family: var(--display); font-size: clamp(2.8rem, 6vw, 4.8rem);
  font-weight: 500; line-height: 1.08; letter-spacing: -0.03em;
  max-width: 700px; margin: 0 auto 20px;
}
.hero h1 em { font-style: italic; color: var(--accent); }
.hero-sub {
  font-size: 1.05rem; color: var(--text-secondary);
  max-width: 480px; margin: 0 auto 36px; line-height: 1.7;
}
.hero-actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }

.btn-primary {
  display: inline-flex; align-items: center; gap: 8px;
  font-family: var(--body); font-size: 0.88rem; font-weight: 600;
  color: var(--bg); background: var(--accent);
  padding: 12px 24px; border-radius: 8px; border: none; cursor: pointer;
  transition: all 0.2s;
}
.btn-primary:hover { background: var(--accent-hover); transform: translateY(-1px); box-shadow: 0 6px 24px var(--accent-soft); }
.btn-ghost {
  display: inline-flex; align-items: center; gap: 8px;
  font-family: var(--body); font-size: 0.88rem; font-weight: 500;
  color: var(--text-secondary); background: transparent;
  padding: 12px 24px; border-radius: 8px; border: 1px solid var(--border); cursor: pointer;
  transition: all 0.2s;
}
.btn-ghost:hover { border-color: var(--text-dim); color: var(--text); }

/* ═══ INDUSTRIES ═══ */
.industries {
  padding: 36px 0; border-bottom: 1px solid var(--border-subtle); text-align: center;
}
.industries-text { font-size: 0.78rem; color: var(--text-dim); letter-spacing: 0.06em; }
.industries-text span {
  font-family: var(--display); font-style: italic; color: var(--text-secondary); font-size: 0.88rem;
}

/* ═══ BENTO GRID ═══ */
.bento-section { padding: 80px 0 40px; }
.bento-header { text-align: center; margin-bottom: 48px; }
.bento-header h2 {
  font-family: var(--display); font-size: clamp(1.8rem, 3.5vw, 2.6rem);
  font-weight: 500; letter-spacing: -0.02em; margin-bottom: 10px;
}
.bento-header p { font-size: 0.95rem; color: var(--text-secondary); }

.bento {
  display: grid;
  grid-template-columns: repeat(12, 1fr);
  grid-auto-rows: minmax(80px, auto);
  gap: var(--gap);
}

/* Card base */
.tile {
  background: var(--bg-card);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius);
  padding: 32px;
  position: relative; overflow: hidden;
  transition: border-color 0.3s, transform 0.3s, box-shadow 0.3s;
}
.tile:hover {
  border-color: var(--glass-border-hover);
  transform: translateY(-3px);
  box-shadow: 0 12px 40px rgba(0,0,0,0.35);
}

/* Tile sizing */
.tile-hero    { grid-column: span 7; grid-row: span 4; }
.tile-medium  { grid-column: span 5; grid-row: span 4; }
.tile-wide    { grid-column: span 6; grid-row: span 3; }
.tile-full    { grid-column: span 12; grid-row: span 3; }

/* Shared tile elements */
.tile-badge {
  display: inline-flex; align-items: center; gap: 6px;
  font-family: var(--mono); font-size: 0.7rem; font-weight: 500;
  color: var(--accent); text-transform: uppercase; letter-spacing: 0.1em;
  background: var(--accent-soft); padding: 5px 12px; border-radius: 100px;
  margin-bottom: 20px; align-self: flex-start;
}
.tile-title {
  font-family: var(--display); font-weight: 500; letter-spacing: -0.02em; margin-bottom: 10px;
}
.tile-price {
  font-family: var(--mono); font-size: 0.82rem; font-weight: 500;
  color: var(--accent); margin-bottom: 14px;
}
.tile-desc {
  font-size: 0.88rem; color: var(--text-secondary); line-height: 1.65; max-width: 440px;
}
.tile-bottom { margin-top: auto; padding-top: 24px; }
.tile-cta {
  display: inline-flex; align-items: center; gap: 6px;
  font-family: var(--mono); font-size: 0.78rem; font-weight: 500;
  color: var(--accent); transition: gap 0.2s;
}
.tile-cta:hover { gap: 10px; }

/* ── TILE: Competitive Intel (Hero) ── */
.tile-intel { display: flex; flex-direction: column; justify-content: space-between; }
.tile-intel::before {
  content: ''; position: absolute; top: -60px; right: -60px;
  width: 260px; height: 260px;
  background: radial-gradient(circle, var(--accent-soft) 0%, transparent 70%);
  pointer-events: none;
}
.tile-intel .tile-title { font-size: 1.8rem; }

.intel-preview {
  margin-top: 20px;
  background: var(--bg); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm);
  padding: 18px 20px;
}
.intel-preview-label {
  font-family: var(--mono); font-size: 0.7rem; font-weight: 500;
  color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.1em;
  margin-bottom: 10px;
}
.intel-preview-items { display: flex; flex-direction: column; gap: 8px; }
.intel-preview-item {
  display: flex; align-items: center; gap: 10px;
  font-size: 0.8rem; color: var(--text-secondary);
}
.intel-preview-item .dot {
  width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0;
}
.dot-accent { background: var(--accent); }
.dot-blue { background: var(--blue); }
.dot-green { background: var(--green); }

/* ── TILE: AI Readiness Audit ── */
.tile-audit { display: flex; flex-direction: column; }
.tile-audit::before {
  content: ''; position: absolute; bottom: -40px; left: -40px;
  width: 200px; height: 200px;
  background: radial-gradient(circle, var(--blue-soft) 0%, transparent 70%);
  pointer-events: none;
}
.tile-audit .tile-title { font-size: 1.45rem; }
.audit-visual { margin-top: 20px; flex: 1; display: flex; flex-direction: column; justify-content: flex-end; }
.audit-bars { display: flex; gap: 6px; align-items: flex-end; height: 80px; }
.audit-bar { flex: 1; border-radius: 4px 4px 0 0; transition: height 0.6s ease; }
.audit-bar:nth-child(1) { height: 45%; background: var(--accent); opacity: 0.35; }
.audit-bar:nth-child(2) { height: 65%; background: var(--accent); opacity: 0.48; }
.audit-bar:nth-child(3) { height: 80%; background: var(--accent); opacity: 0.6; }
.audit-bar:nth-child(4) { height: 55%; background: var(--accent); opacity: 0.72; }
.audit-bar:nth-child(5) { height: 95%; background: var(--accent); opacity: 0.85; }
.audit-bar:nth-child(6) { height: 70%; background: var(--accent); opacity: 1; }
.tile-audit:hover .audit-bar:nth-child(1) { height: 55%; }
.tile-audit:hover .audit-bar:nth-child(2) { height: 75%; }
.tile-audit:hover .audit-bar:nth-child(3) { height: 60%; }
.tile-audit:hover .audit-bar:nth-child(4) { height: 90%; }
.tile-audit:hover .audit-bar:nth-child(5) { height: 70%; }
.tile-audit:hover .audit-bar:nth-child(6) { height: 85%; }
.audit-labels { display: flex; justify-content: space-between; margin-top: 8px; }
.audit-labels span {
  font-family: var(--mono); font-size: 0.7rem; color: var(--text-secondary);
  text-transform: uppercase; letter-spacing: 0.06em;
}

/* ── TILE: Weekly Digest ── */
.tile-digest { display: flex; flex-direction: column; }
.tile-digest::before {
  content: ''; position: absolute; bottom: -30px; right: -30px;
  width: 160px; height: 160px;
  background: radial-gradient(circle, var(--coral-soft) 0%, transparent 70%);
  pointer-events: none;
}
.tile-digest .tile-title { font-size: 1.6rem; }
.tile-digest .tile-desc { max-width: 540px; }
.digest-head {
  display: flex; align-items: flex-start; justify-content: space-between;
  gap: 24px; flex-wrap: wrap; margin-bottom: 24px;
}
.digest-cta { padding-top: 8px; white-space: nowrap; }
.digest-tag {
  display: inline-flex; align-items: center; gap: 6px;
  font-family: var(--mono); font-size: 0.62rem; font-weight: 500;
  color: var(--coral); text-transform: uppercase; letter-spacing: 0.1em;
  background: var(--coral-soft); padding: 5px 12px; border-radius: 100px;
  margin-bottom: 16px; align-self: flex-start;
}
.digest-preview {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px;
}
.digest-item {
  display: flex; align-items: center; gap: 10px;
  background: var(--bg); border: 1px solid var(--border-subtle);
  border-radius: var(--radius-sm); padding: 12px 16px;
  font-size: 0.82rem; color: var(--text-secondary);
}
.digest-icon { font-size: 0.95rem; }
@media (max-width: 768px) {
  .digest-preview { grid-template-columns: 1fr; }
}

/* ── TILE: Newsletter ── */
.tile-news {
  display: flex; flex-direction: column; align-items: center; text-align: center;
  padding: 48px 32px;
}
.tile-news::before {
  content: ''; position: absolute; top: -60px; left: 50%; transform: translateX(-50%);
  width: 500px; height: 300px;
  background: radial-gradient(ellipse, var(--accent-glow) 0%, transparent 70%);
  pointer-events: none;
}
.news-info { max-width: 520px; width: 100%; position: relative; z-index: 1; }
.news-info .tile-title { font-size: 1.8rem; margin-bottom: 12px; }
.news-desc {
  font-size: 0.95rem; color: var(--text-secondary); line-height: 1.7; margin-bottom: 28px;
}
.news-archive-link {
  display: inline-block; margin-top: 18px;
  font-family: var(--mono); font-size: 0.78rem; color: var(--accent);
  letter-spacing: 0.04em; transition: opacity 0.2s;
}
.news-archive-link:hover { opacity: 0.75; }

/* Buttondown form — styled to match */
.embeddable-buttondown-form { display: flex; gap: 10px; }
.embeddable-buttondown-form label { display: none; }
.embeddable-buttondown-form input[type="email"] {
  flex: 1;
  font-family: var(--body); font-size: 0.88rem;
  padding: 13px 18px;
  background: var(--bg); border: 1px solid var(--border);
  border-radius: 8px; color: var(--text); outline: none;
  transition: border-color 0.2s;
}
.embeddable-buttondown-form input[type="email"]::placeholder { color: var(--text-dim); }
.embeddable-buttondown-form input[type="email"]:focus { border-color: var(--accent); }
.embeddable-buttondown-form input[type="submit"] {
  font-family: var(--body); font-size: 0.85rem; font-weight: 600;
  padding: 13px 22px;
  background: var(--accent); color: var(--bg);
  border: none; border-radius: 8px; cursor: pointer;
  transition: background 0.2s;
  white-space: nowrap;
}
.embeddable-buttondown-form input[type="submit"]:hover { background: var(--accent-hover); }
.embeddable-buttondown-form p {
  display: none; /* hide "Powered by Buttondown" */
}
.form-note {
  font-size: 0.75rem; color: var(--text-dim); margin-top: 10px;
}

/* ═══ FEATURED RESEARCH ═══ */
.featured-research {
  padding: 64px 0;
  border-top: 1px solid var(--border-subtle);
}
.featured-research-inner {
  background: var(--bg-card);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-sm);
  padding: 40px 48px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 40px;
}
.featured-research-text {
  max-width: 600px;
}
.featured-research-label {
  font-family: var(--mono);
  font-size: 0.65rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--accent);
  margin-bottom: 12px;
}
.featured-research-text h3 {
  font-family: var(--display);
  font-size: clamp(1.2rem, 2vw, 1.5rem);
  font-weight: 500;
  letter-spacing: -0.01em;
  margin-bottom: 10px;
}
.featured-research-text p {
  font-size: 0.88rem;
  color: var(--text-secondary);
  line-height: 1.7;
}
.featured-research-link {
  flex-shrink: 0;
}
.featured-research-link a {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: var(--mono);
  font-size: 0.75rem;
  letter-spacing: 0.04em;
  color: var(--accent);
  text-decoration: none;
  padding: 12px 24px;
  border: 1px solid var(--accent);
  border-radius: var(--radius-sm);
  transition: background 0.2s, color 0.2s;
  white-space: nowrap;
}
.featured-research-link a:hover {
  background: var(--accent);
  color: var(--bg);
}
.featured-research-secondary {
  text-align: center; margin-top: 24px;
}
.featured-research-secondary a {
  font-family: var(--mono); font-size: 0.78rem;
  color: var(--text-secondary); letter-spacing: 0.04em;
  transition: color 0.2s;
}
.featured-research-secondary a:hover { color: var(--accent); }
@media (max-width: 768px) {
  .featured-research-inner {
    flex-direction: column;
    padding: 32px 24px;
    text-align: center;
  }
  .featured-research-link { width: 100%; }
  .featured-research-link a { width: 100%; justify-content: center; }
}

/* ═══ ABOUT ═══ */
.about-strip { padding: 80px 0; border-top: 1px solid var(--border-subtle); }
.about-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center; }
.about-inner h2 {
  font-family: var(--display); font-size: clamp(1.8rem, 3vw, 2.4rem);
  font-weight: 500; letter-spacing: -0.02em; margin-bottom: 20px;
}
.about-inner h2 em { font-style: italic; color: var(--accent); }
.about-text { font-size: 0.92rem; color: var(--text-secondary); line-height: 1.75; }
.about-text + .about-text { margin-top: 14px; }
.about-metrics { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.metric {
  background: var(--bg-card); border: 1px solid var(--glass-border);
  border-radius: var(--radius-sm); padding: 24px; text-align: center;
}
.metric-val {
  font-family: var(--display); font-size: 1.8rem; color: var(--accent);
  line-height: 1.2; margin-bottom: 4px;
}
.metric-label {
  font-family: var(--mono); font-size: 0.65rem; color: var(--text-dim);
  text-transform: uppercase; letter-spacing: 0.08em;
}

/* ═══ PRODUCTS MENTION ═══ */
.products-mention { padding: 64px 0; border-top: 1px solid var(--border-subtle); }
.products-mention-inner {
  background: var(--bg-card);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-sm);
  padding: 36px 40px;
  display: flex; align-items: center; justify-content: space-between; gap: 32px;
}
.products-mention-text { max-width: 640px; }
.products-mention-label {
  font-family: var(--mono); font-size: 0.65rem; text-transform: uppercase;
  letter-spacing: 0.1em; color: var(--accent); margin-bottom: 12px;
}
.products-mention-text h3 {
  font-family: var(--display); font-size: clamp(1.3rem, 2.2vw, 1.7rem);
  font-weight: 500; letter-spacing: -0.01em; line-height: 1.25; margin-bottom: 12px;
}
.products-mention-text h3 em { font-style: italic; color: var(--accent); }
.products-mention-text p { font-size: 0.9rem; color: var(--text-secondary); line-height: 1.7; }
.products-mention-link a {
  display: inline-flex; align-items: center; gap: 8px;
  font-family: var(--mono); font-size: 0.78rem; letter-spacing: 0.04em;
  color: var(--accent); padding: 12px 24px;
  border: 1px solid var(--accent); border-radius: var(--radius-sm);
  white-space: nowrap; transition: background 0.2s, color 0.2s;
}
.products-mention-link a:hover { background: var(--accent); color: var(--bg); }
@media (max-width: 768px) {
  .products-mention-inner { flex-direction: column; padding: 28px 22px; text-align: center; }
  .products-mention-link { width: 100%; }
  .products-mention-link a { width: 100%; justify-content: center; }
}

/* ═══ CTA ═══ */
.cta { text-align: center; padding: 100px 0; position: relative; }
.cta::before {
  content: ''; position: absolute; top: 0; left: 50%; transform: translateX(-50%);
  width: 500px; height: 400px;
  background: radial-gradient(circle, var(--accent-glow) 0%, transparent 60%);
  pointer-events: none;
}
.cta h2 {
  font-family: var(--display); font-size: clamp(1.8rem, 3.5vw, 2.6rem);
  font-weight: 500; letter-spacing: -0.02em;
  max-width: 500px; margin: 0 auto 12px;
}
.cta p { font-size: 0.95rem; color: var(--text-secondary); margin-bottom: 32px; }
.cta-email { font-family: var(--mono); font-size: 0.88rem; color: var(--accent); margin-top: 20px; }

/* ═══ FOOTER ═══ */
footer { padding: 40px 0; border-top: 1px solid var(--border-subtle); }
.footer-inner { display: flex; justify-content: space-between; align-items: center; }
.footer-left { font-size: 0.78rem; color: var(--text-dim); }
.footer-links { display: flex; gap: 24px; }
.footer-links a { font-size: 0.78rem; color: var(--text-dim); transition: color 0.2s; }
.footer-links a:hover { color: var(--text-secondary); }

/* ═══ RESPONSIVE ═══ */
@media (max-width: 1024px) {
  .tile-hero { grid-column: span 12; grid-row: span 3; }
  .tile-medium { grid-column: span 6; grid-row: span 3; }
  .tile-wide { grid-column: span 6; grid-row: span 3; }
  .tile-full { grid-column: span 12; }
}
@media (max-width: 768px) {
  .nav-links a:not(.nav-cta) { display: none; }
  .tile-hero, .tile-medium, .tile-wide, .tile-full { grid-column: span 12; grid-row: auto; }
  .tile-news { padding: 36px 24px; }
  .about-inner { grid-template-columns: 1fr; gap: 40px; }
  .about-metrics { order: -1; }
  .footer-inner { flex-direction: column; gap: 12px; text-align: center; }
  .hero { padding: 140px 0 60px; }
  .bento-section { padding: 60px 0 20px; }
  .intel-preview { display: none; }
  .embeddable-buttondown-form { flex-direction: column; }
}
@media (max-width: 500px) {
  .hero-actions { flex-direction: column; align-items: center; }
  .btn-primary, .btn-ghost { width: 100%; justify-content: center; }
  .about-metrics { grid-template-columns: 1fr; }
}
</style>
{% endblock %}

