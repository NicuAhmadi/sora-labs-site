<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-J1F2ETBV5K"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-J1F2ETBV5K');
  </script>
  <link rel="stylesheet" href="/css/tokens.css">
  <style>
    /* Site-wide accessible focus styling (adapts to each page's accent) */
    a:focus-visible, button:focus-visible, input:focus-visible,
    textarea:focus-visible, select:focus-visible {
      outline: 2px solid var(--accent, #C9A84C);
      outline-offset: 2px;
      border-radius: 3px;
    }
    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto !important; }
    }
    /* Shared three-zone site footer (identity · nav · social) */
    .site-footer { margin: 0; padding: 34px 0; border-top: 1px solid var(--border-subtle); background: var(--bg); }
    .site-footer .sf-inner { max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
    .site-footer .sf-copy { font-size: 0.84rem; color: var(--text-dim); flex-shrink: 0; }
    .site-footer .sf-nav { display: flex; gap: 20px; flex-wrap: wrap; justify-content: center; flex: 1 1 auto; }
    .site-footer .sf-nav a { font-family: var(--body); font-size: 0.84rem; color: var(--text-secondary); text-decoration: none; transition: color 0.2s; }
    .site-footer .sf-nav a:hover { color: var(--text); }
    .site-footer .sf-social { display: flex; gap: 15px; align-items: center; flex-shrink: 0; }
    .site-footer .sf-social a { display: inline-flex; align-items: center; color: var(--text-dim); text-decoration: none; transition: color 0.2s; }
    .site-footer .sf-social a:hover { color: var(--accent); }
    @media (max-width: 760px) {
      .site-footer .sf-inner { flex-direction: column; text-align: center; gap: 18px; }
      .site-footer .sf-nav { justify-content: center; order: 2; }
      .site-footer .sf-social { order: 3; }
    }
  </style>
  <link rel="canonical" href="https://sora-labs.net{{ page.url }}">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Sora Labs",
    "url": "https://sora-labs.net/",
    "email": "nadia@sora-labs.net",
    "description": "Founder-led AI consulting and market-intelligence firm helping local businesses win more business, run leaner, and understand their market.",
    "knowsAbout": ["AI consulting", "Business process automation", "Competitive intelligence", "Small business automation", "Market intelligence"],
    "areaServed": "United States",
    "sameAs": ["https://x.com/NadiaReports", "https://www.linkedin.com/company/soralabs-ai/", "https://buttondown.com/nclawdev"]
  }
  </script>
  {% block head %}{% endblock %}
</head>
<body>
  {% block nav %}{% endblock %}
  {% block content %}{% endblock %}
  {% block footer %}{% endblock %}
  {% block scripts %}{% endblock %}
</body>
</html>
